[[0,390,210],[340,320,110],[580,390,95,'c'],[825,320,110,'m'],[1060,390,100],[1310,320,95],[1560,250,100,'c'],[1800,320,95],[2050,250,100],[2290,180,100,'m'],[2540,250,105],[2790,320,210]],
[[0,590,210],[335,520,105],[575,450,100],[815,380,105,'c'],[1055,310,105],[1295,240,110],[1540,170,105,'m'],[1780,100,110],[2025,170,105],[2270,240,100,'c'],[2515,170,100],[2760,100,210]],
[[0,510,210],[345,440,105],[585,370,100,'b'],[830,300,110],[1070,230,120],[1100,60,120],[855,-10,100,'c'],[610,-80,105],[365,-150,105],[120,-220,110],[365,-290,100],[610,-360,210]],
[[0,300,210],[345,370,105,'c'],[595,440,100],[845,510,100,'m'],[1095,580,110],[1345,650,105],[1595,580,100,'b'],[1840,510,100],[2085,440,105],[2330,370,100,'c'],[2575,300,100],[2820,230,210]],

  if(h.type==='jaw'||h.type==='fire'){h.x=b.x+h.offsetX;h.y=b.y;const q=(s.t+h.phase)%h.period,on=h.type==='fire'?2.5:2.3;h.warning=q>=on-.7&&q<on;h.active=b.active&&q>=on&&q<on+(h.type==='fire'?1.1:.6);h.cycle=q;}
